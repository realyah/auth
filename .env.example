# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Database Connection URL
MONGODB_URI=mongodb://127.0.0.1:27017/todolist

# Redis: stores sessions and rate-limit counters. REQUIRED in production.
# Unset in development = in-memory stores (sessions lost on restart).
# REDIS_URL=redis://127.0.0.1:6379

# Session cookie signing secret. REQUIRED in production (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me

# AES-256 key that encrypts TOTP (MFA) secrets in the database: exactly 64 hex chars.
# REQUIRED in production. Changing it makes existing MFA enrolments unusable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# Name shown in the authenticator app
# MFA_ISSUER=ToDo App

# Comma-separated frontend origins allowed to call the API with cookies ("*" is not allowed).
# Default in development: http://localhost:3000,http://localhost:5173
# CORS_ORIGIN=https://app.example.com

# Secure cookie (+ "__Host-sid" name) and HTTPS-only requests. Default: on in production.
# COOKIE_SECURE=true
# FORCE_HTTPS=true

# Set when running behind a reverse proxy (e.g. "1" or "loopback") so client IPs and
# HTTPS are read from X-Forwarded-For / X-Forwarded-Proto. Leave unset otherwise.
# TRUST_PROXY=1

# Login attempts per IP per 15 minutes (default 10)
# LOGIN_RATE_LIMIT_MAX=10

# Cloudflare Turnstile secret. When set, login and register require body.captchaToken.
# TURNSTILE_SECRET_KEY=

# Optional URL that receives every security event as a JSON POST (they also go to stdout)
# SECURITY_LOG_WEBHOOK_URL=

# Optional: directory for uploaded profile pictures (default ./uploads)
# UPLOAD_DIR=./uploads
