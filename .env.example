# Server Configuration
PORT=4000

# MongoDB Database Connection URL
MONGODB_URI=mongodb://127.0.0.1:27017/todolist

# JWT Authentication Secret and Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Optional: comma-separated allowed CORS origins (default "*" = allow all)
# CORS_ORIGIN=http://localhost:3000

# Optional: set when running behind a reverse proxy (e.g. "1" or "loopback")
# so client IPs are read from X-Forwarded-For. Leave unset otherwise.
# TRUST_PROXY=1
